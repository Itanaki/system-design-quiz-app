generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model Question {
    id          String  @id @default(cuid())
    prompt      String  @unique
    options     Json
    correctAnswer String
    explanation String?
    difficulty  String
    topics      String[]
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    AttemptAnswer AttemptAnswer[]
    mastery     UserQuestionMastery[]

    @@index([difficulty])
}

model QuizAttempt {
    id          String      @id @default(cuid())
    userId      String?
    score       Int
    total       Int
    difficulty  String?
    topic       String?
    sessionId   String?
    createdAt   DateTime    @default(now())
    completedAt DateTime?
    answers     AttemptAnswer[]
}

model AttemptAnswer {
    id      String  @id @default(cuid())
    attemptId   String
    questionId  String
    selected    String
    correct     Boolean
    attempt     QuizAttempt @relation(fields: [attemptId], references: [id])
    question    Question?   @relation(fields: [questionId], references: [id])
    @@index([attemptId])
    @@index([questionId])
}

model UserProfile {
    id                 String   @id
    displayName        String
    leaderboardOptOut  Boolean  @default(false)
    status             String   @default("active")
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt

    userBadges UserBadge[]
}

model UserQuestionMastery {
    id             String    @id @default(cuid())
    userId         String
    questionId     String
    bestCorrect    Boolean   @default(false)
    firstCorrectAt DateTime?
    lastAttemptAt  DateTime
    attemptCount   Int       @default(1)
    question       Question  @relation(fields: [questionId], references: [id])

    @@unique([userId, questionId])
    @@index([userId, bestCorrect])
    @@index([questionId, bestCorrect])
}

enum BadgeCategory {
    MASTERY
    PROGRESSION
    CONSISTENCY
    TOPIC
    META
}

enum MilestoneRuleType {
    QUESTION_MASTERY_SNAPSHOT
}

enum MilestoneStatus {
    DRAFT
    PUBLISHED
    RETIRED
}

model Badge {
    id          String        @id @default(cuid())
    displayName String
    description String
    category    BadgeCategory @default(MASTERY)
    iconUrl     String?
    isActive    Boolean       @default(true)
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt

    milestones Milestone[]
    userBadges UserBadge[]
}

model Milestone {
    id                  String            @id @default(cuid())
    badgeId             String
    key                 String
    version             Int
    ruleType            MilestoneRuleType @default(QUESTION_MASTERY_SNAPSHOT)
    status              MilestoneStatus   @default(DRAFT)
    publishedAt         DateTime?
    eligibilityStartsAt DateTime?
    createdAt           DateTime          @default(now())
    updatedAt           DateTime          @updatedAt

    badge     Badge              @relation(fields: [badgeId], references: [id])
    questions MilestoneQuestion[]
    userBadges UserBadge[]

    @@unique([key, version])
    @@index([status])
}

model MilestoneQuestion {
    id          String @id @default(cuid())
    milestoneId String
    questionId  String

    // Snapshot fields preserve the published requirement if the question changes.
    prompt        String
    options       Json
    correctAnswer String
    difficulty    String
    topics        String[]

    milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

    @@unique([milestoneId, questionId])
    @@index([questionId])
}

model UserBadge {
    id          String   @id @default(cuid())
    userId      String
    badgeId     String
    milestoneId String
    earnedAt    DateTime @default(now())
    metadata    Json?
    createdAt   DateTime @default(now())

    badge     Badge     @relation(fields: [badgeId], references: [id])
    milestone Milestone @relation(fields: [milestoneId], references: [id])
    user      UserProfile @relation(fields: [userId], references: [id])

    @@unique([userId, milestoneId])
    @@index([userId])
}